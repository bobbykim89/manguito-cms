{
  "$schema": "https://turbo.build/schema.json",
  // Root configs every package's typecheck and lint read: a change to either
  // must invalidate their cached results.
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DB_URL"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "smoke": {
      "dependsOn": ["test"],
      "cache": false,
      "passThroughEnv": ["DB_URL"]
    }
  }
}
