{
  "$schema": "https://turbo.build/schema.json",
  // Root configs every package's typecheck and lint read: a change to either
  // must invalidate their cached results.
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DB_URL"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // db and api type-check their tests, which import test-utils, which
    // imports the built db and api. So each needs its own build first, or a
    // rebuild running alongside clears the dist it is reading.
    "@bobbykim/manguito-cms-db#typecheck": {
      "dependsOn": ["build"]
    },
    "@bobbykim/manguito-cms-api#typecheck": {
      "dependsOn": ["build"]
    },
    "smoke": {
      "dependsOn": ["test"],
      "cache": false,
      "passThroughEnv": ["DB_URL"]
    }
  }
}
